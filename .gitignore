# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Local runtime data & logs
logs/
*.log
*.db
*.db-shm
*.db-wal
*.sqlite
dashboard.log
trades_log.db
jarvis_trade_memory.db
jarvis.lock
jarvis_bandit_state.json
test_bandit_state.json
active_tunnel_url.txt
.jarvis_secret_key
*.secret_key
.jarvis_admin_pass
system_diagnostics.json
opportunities.json
trade_plans.json
scratch/

# AntiGravity system files
.system_generated/
jarvis_online_ml_weights.json
scratch_*.json

# Historical market data lake
data/market/
data/raw/
data/snapshots/
data/manifests/
data/metadata/

# Canonical runtime database directory (see jarvis/config/paths.py)
!data/*.db
data/*.db-shm
data/*.db-wal
# Timestamped snapshots taken before a repair (tools/repair_forecast_column.py).
# These are binary and local-only; `data/*.db` above does not match them because
# the suffix is appended, not replaced.
data/*.db.bak-*

# Derived signal-scan cache (regenerate with tools/scan_signals.py)
data/signals/

# Trained model binaries. Regenerate with tools/train_meta_labeler.py; the
# numbers that matter are committed as data/models/meta_labeler_report.json, and
# jarvis/intelligence/meta_labeler.py self-trains when the .joblib is absent.
# A 121 KB opaque blob in git buys nothing that the report does not already say.
data/models/*.joblib

# Per-candidate replay frames from tools/verify_prioritization.py.
# Regenerable (~29 MB) evidence; the distilled results are committed as
# reports/prioritization_verification.json instead.
reports/_prio_frame_*.parquet

# Runtime output of the geometry optimiser (/api/backtest/run). Each job writes
# one JSON per symbol; regenerable by re-running the job, so not committed.
reports/optimizer/

# Local scratch space for one-off probes and diagnostics.
.scratch/
